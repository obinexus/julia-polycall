# julia-polycallrc - Julia runtime overrides for Polycall
#
# Grammar: the core's single configuration grammar. Check this file with
#   polycall config validate julia-polycallrc
# The binding loads it through polycall_ffi_run_config(path, 1)
# (JuliaPolycall.run_config), which also rejects unknown keys and settings
# this build cannot honour (tls_enabled=true). There is no per-language parser.

log_level=info
max_connections=1000
network_timeout=5000
tls_enabled=false
