{
  "name": "@obinexusltd/julia-polycall",
  "version": "1.0.0",
  "description": "Julia binding (direct ccall) for the Polycall C library, binding ABI v1 (polycall >= 1.1.0).",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "Project.toml",
    "src/",
    "examples/",
    "test/",
    "tests/",
    "scripts/",
    "Makefile",
    "julia-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "example": "examples",
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "test": "make test",
    "test:package": "node tests/package.test.js",
    "verify:dry": "make verify-dry",
    "verify": "npm run verify:dry && npm run test:package",
    "prepack": "node tests/package.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/julia-polycall.git"
  },
  "keywords": [
    "libpolycall",
    "polycall",
    "julia",
    "ccall",
    "ffi"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/julia-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/julia-polycall#readme"
}
